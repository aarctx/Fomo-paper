{
  "manifest_version": 3,
  "name": "Paperdesk \u2014 Fomo paper trader",
  "version": "0.4.2",
  "description": "Manual paper trades and portfolio history alongside Fomo. Virtual money only.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.dexscreener.com/*",
    "https://api.etherscan.io/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Paperdesk portfolio",
    "default_icon": {
      "16": "icons/paperdesk-16.png",
      "32": "icons/paperdesk-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://fomo.family/*",
        "https://www.fomo.family/*",
        "https://fomo.fun/*",
        "https://www.fomo.fun/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "app.html",
        "app.css",
        "app.js",
        "ledger.js",
        "market.js",
        "bridge.js",
        "service.js",
        "platform.js",
        "chart-data.js",
        "chart-view.js",
        "lightweight-charts.js"
      ],
      "matches": [
        "https://fomo.family/*",
        "https://www.fomo.family/*",
        "https://fomo.fun/*",
        "https://www.fomo.fun/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.dexscreener.com https://api.etherscan.io"
  },
  "icons": {
    "16": "icons/paperdesk-16.png",
    "32": "icons/paperdesk-32.png",
    "48": "icons/paperdesk-48.png",
    "128": "icons/paperdesk-128.png"
  }
}
